{
  "name": "dof-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-server.mjs && tsc --noEmit && vite build",
    "build:desktop": "tsc --noEmit && vite build --mode desktop",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "tauri icon brand/app-icon.png",
    "test": "node scripts/run-tests.mjs",
    "gen": "node scripts/gen-wrapped.mjs",
    "gen:check": "node scripts/check-gen-wrapped.mjs",
    "build:server": "node scripts/build-server.mjs",
    "dev:server": "node scripts/dev-server.mjs",
    "check": "tsc --noEmit && tsc --noEmit -p server",
    "lint": "eslint ."
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "mongodb": "^7.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "mongodb-memory-server-core": "^10.4.3",
    "prettier": "^3.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.0"
  }
}
